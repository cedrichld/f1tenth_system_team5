# Hokuyo UTM-30LX USB LiDAR — exposes /dev/sensors/hokuyo with world-rw perms.
# Install: sudo cp 99-hokuyo.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="tty", ATTRS{idVendor}=="15d1", ATTRS{idProduct}=="0000", MODE="0666", GROUP="dialout", SYMLINK+="sensors/hokuyo"
